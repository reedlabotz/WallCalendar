[Unit]
Description=Wall Calendar Battery Runner
After=local-fs.target pisugar-server.service
Wants=pisugar-server.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/reedlabotz
ExecStart=/home/reedlabotz/wallcalendar --shutdown
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
